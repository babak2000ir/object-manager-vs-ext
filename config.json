{
  "github": {
    "providerId": "github",
    "apiUrl": "https://api.github.com",
    "acceptHeader": "application/vnd.github+json",
    "apiVersion": "2022-11-28",
    "organizationPageSize": 100,
    "scopes": [
      "read:org",
      "repo"
    ]
  },
  "rangeRepository": {
    "name": "bc-object-management",
    "displayName": "bc-object-manager",
    "fileName": "data.json",
    "branch": "main",
    "objectReservationsDirectory": "object-reservations",
    "initialData": {
      "Remarks": [
        "Describe the range allocation here."
      ],
      "ranges": [
        {
          "id": "00000000-0000-0000-0000-000000000000",
          "name": "Extension Name",
          "publisher": "Publisher",
          "ranges": [
            {
              "from": 50000,
              "to": 50099
            },
            {
              "from": 50100,
              "to": 50199
            }
          ]
        }
      ]
    }
  },
  "workspace": {
    "appManifestFileName": "app.json",
    "appManifestPattern": "**/app.json",
    "alSourcePattern": "**/*.al",
    "alSourceExtension": ".al",
    "appIdPattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
  },
  "settings": {
    "repositoryOwner": "repositoryOwner",
    "repositoryAccountId": "repositoryAccountId",
    "repositoryOwnerSource": "repositoryOwnerSource"
  }
}
