{
  "name": "object-manager",
  "displayName": "BC Object Manager - TPE",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:al",
    "workspaceContains:**/app.json"
  ],
  "extensionDependencies": [
    "ms-dynamics-smb.al",
    "vscode.git"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "object-manager.manageAccountPreference",
        "title": "Object Manager: Manage Account Preference"
      },
      {
        "command": "object-manager.createUpdateApplicationRange",
        "title": "Object Manager: Create or Update Application Range"
      },
      {
        "command": "object-manager.forceApplicationRangeToRepository",
        "title": "Object Manager: Force app.json Range to data.json",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "object-manager.forceApplicationRangeToRepositoryBusy",
        "title": "Object Manager: Updating app.json Range",
        "icon": "$(loading~spin)"
      },
      {
        "command": "object-manager.syncObjectReservation",
        "title": "Object Manager: Sync Object Reservation",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "object-manager.syncObjectReservationBusy",
        "title": "Object Manager: Syncing Object Reservation",
        "icon": "$(loading~spin)"
      },
      {
        "command": "object-manager.installGitValidationHooks",
        "title": "Object Manager: Install Git Validation Hooks"
      },
      {
        "command": "object-manager.removeGitValidationHooks",
        "title": "Object Manager: Remove Git Validation Hooks"
      }
    ],
    "menus": {
      "view/item/context": [
        {
          "command": "object-manager.forceApplicationRangeToRepository",
          "when": "view == object-manager.organizationUsage && viewItem == mismatchedApplicationRange",
          "group": "inline"
        },
        {
          "command": "object-manager.forceApplicationRangeToRepositoryBusy",
          "when": "view == object-manager.organizationUsage && viewItem == forcingApplicationRange",
          "group": "inline",
          "enablement": "false"
        },
        {
          "command": "object-manager.syncObjectReservation",
          "when": "view == object-manager.extensionUsage && viewItem == unsyncedObject",
          "group": "inline"
        },
        {
          "command": "object-manager.syncObjectReservationBusy",
          "when": "view == object-manager.extensionUsage && viewItem == syncingObject",
          "group": "inline",
          "enablement": "false"
        }
      ]
    },
    "configuration": {
      "title": "BC Object Manager",
      "properties": {
        "object-manager.repositoryOwner": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "GitHub account or organization that owns the Object Manager repository."
        },
        "object-manager.repositoryAccountId": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "GitHub account associated with the selected repository owner."
        },
        "object-manager.repositoryCheckIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "scope": "window",
          "description": "Minutes between checks for the selected GitHub repository."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "object-manager",
          "title": "Object Manager",
          "icon": "media/object-manager.svg"
        }
      ]
    },
    "views": {
      "object-manager": [
        {
          "id": "object-manager.commands",
          "name": "Commands"
        },
        {
          "id": "object-manager.extensionUsage",
          "name": "Extension Usage"
        },
        {
          "id": "object-manager.organizationUsage",
          "name": "Organization Usage"
        },
        {
          "id": "object-manager.debug",
          "name": "Information"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.12.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
