{
  "name": "object-manager",
  "displayName": "BC Object Manager - TPE",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.138.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "object-manager.helloWorld",
        "title": "Hello World"
      },
      {
        "command": "object-manager.manageAccountPreference",
        "title": "Manage Extension Account Preference"
      }
    ],
    "configuration": {
      "title": "BC Object Manager",
      "properties": {
        "object-manager.repositoryOwner": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "GitHub account or organization that owns the bc-object-manager repository."
        },
        "object-manager.repositoryAccountId": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "GitHub account associated with the selected repository owner."
        },
        "object-manager.repositoryCheckIntervalMinutes": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "scope": "window",
          "description": "Minutes between checks for the selected GitHub repository."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "object-manager",
          "title": "Object Manager",
          "icon": "media/object-manager.svg"
        }
      ]
    },
    "views": {
      "object-manager": [
        {
          "id": "object-manager.commands",
          "name": "Commands"
        },
        {
          "id": "object-manager.extensionUsage",
          "name": "Extension Usage"
        },
        {
          "id": "object-manager.organizationUsage",
          "name": "Organization Usage"
        },
        {
          "id": "object-manager.debug",
          "name": "Information"
        }
      ]
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.138.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "globals": "^17.12.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
